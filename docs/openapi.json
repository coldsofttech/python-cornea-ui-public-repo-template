            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Invalid name."
          }
        },
        "summary": "Greet someone",
        "tags": [
          "v1"
        ]
      }
