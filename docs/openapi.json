{
  "components": {
    "schemas": {
      "GreetingCreate": {
        "properties": {
          "name": {
            "examples": [
              "Ada"
            ],
            "maxLength": 100,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "GreetingCreate",
        "type": "object"
      },
      "GreetingResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "message": {
            "examples": [
              "Hello, Ada!"
            ],
            "title": "Message",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "message"
        ],
        "title": "GreetingResponse",
        "type": "object"
      },
      "GreetingUpdate": {
        "description": "Fields left out are not changed.",
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Grace"
            ],
            "title": "Name"
          }
        },
        "title": "GreetingUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "HelloResponse": {
        "properties": {
          "message": {
            "examples": [
              "Hello, Ada!"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "HelloResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Version of the running service.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
