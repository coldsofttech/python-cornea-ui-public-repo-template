  "info": {
    "description": "Example HTTP API built on **example_package**.",
    "title": "example-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/greetings": {
      "get": {
        "description": "Return every stored greeting.",
        "operationId": "list_greetings_api_v1_greetings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GreetingResponse"
                  },
                  "title": "Response List Greetings Api V1 Greetings Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List greetings",
        "tags": [
          "v1"
        ]
      },
      "post": {
        "description": "Store a greeting for ``name``.",
        "operationId": "create_greeting_api_v1_greetings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GreetingCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Invalid name."
          }
        },
        "summary": "Create a greeting",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/greetings/{greeting_id}": {
      "delete": {
        "description": "Remove a greeting.",
        "operationId": "delete_greeting_api_v1_greetings__greeting_id__delete",
        "parameters": [
          {
            "description": "Greeting id.",
            "in": "path",
            "name": "greeting_id",
            "required": true,
            "schema": {
              "description": "Greeting id.",
              "minimum": 1,
              "title": "Greeting Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Greeting not found."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a greeting",
        "tags": [
          "v1"
        ]
      },
      "get": {
        "description": "Return one greeting.",
        "operationId": "get_greeting_api_v1_greetings__greeting_id__get",
        "parameters": [
          {
            "description": "Greeting id.",
            "in": "path",
            "name": "greeting_id",
            "required": true,
            "schema": {
              "description": "Greeting id.",
              "minimum": 1,
              "title": "Greeting Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Greeting not found."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get a greeting",
        "tags": [
          "v1"
        ]
      },
      "patch": {
        "description": "Change only the fields that are sent.",
        "operationId": "update_greeting_api_v1_greetings__greeting_id__patch",
        "parameters": [
          {
            "description": "Greeting id.",
            "in": "path",
            "name": "greeting_id",
            "required": true,
            "schema": {
              "description": "Greeting id.",
              "minimum": 1,
              "title": "Greeting Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GreetingUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Greeting not found."
          },
          "422": {
            "description": "Invalid name."
          }
        },
        "summary": "Update a greeting",
        "tags": [
          "v1"
        ]
      },
      "put": {
        "description": "Replace the name, and so the message, of a greeting.",
        "operationId": "replace_greeting_api_v1_greetings__greeting_id__put",
        "parameters": [
          {
            "description": "Greeting id.",
            "in": "path",
            "name": "greeting_id",
            "required": true,
            "schema": {
              "description": "Greeting id.",
              "minimum": 1,
              "title": "Greeting Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GreetingCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GreetingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Greeting not found."
          },
          "422": {
            "description": "Invalid name."
          }
        },
        "summary": "Replace a greeting",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/hello/{name}": {
      "get": {
        "description": "Return a greeting without storing it.",
        "operationId": "hello_api_v1_hello__name__get",
        "parameters": [
          {
            "description": "Who to greet.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Who to greet.",
              "title": "Name",
              "type": "string"
            }
          }
